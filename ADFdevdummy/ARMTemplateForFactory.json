			"defaultValue": "https://adlsdevdummy.dfs.core.windows.net/"
		},
		"LS_SQLSERVER_TBLLKUP_properties_typeProperties_server": {
			"type": "string",
			"defaultValue": "SRIDHAR\\SQLEXPRESS01"
		},
		"LS_SQLSERVER_TBLLKUP_properties_typeProperties_database": {
			"type": "string",
			"defaultValue": "MIGRATIONPROJECT"
		},
		"LS_SQLSERVER_TBLLKUP_properties_typeProperties_userName": {
			"type": "string",
			"defaultValue": "SRIDHAR\\gudap"
		},
